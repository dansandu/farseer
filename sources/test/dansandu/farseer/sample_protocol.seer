namespace dansandu.farseer.sample_protocol;

message StaticMessage
{
    i32 integer;
    bool boolean;
}

message EmptyMessage
{
}

message DynamicMessage
{
    list<StaticMessage> messages;
    string name;
}

request MyRequest
{
    string user;
    string password;

    response
    {
        list<string> contacts;
        u64 authenticationToken;
    }
}

request StressRequest
{
    u32 sent;

    response
    {
        u32 received;
    }
}
