namespace dansandu.farseer.sample_protocol;

message StaticMessage
{
    int32 integer;
    bool boolean;
}

message EmptyMessage
{
}

message DynamicMessage
{
    list<StaticMessage> messages;
    string name;
}

request MyRequest
{
    string user;
    string password;

    response
    {
        list<string> contacts;
        uint64 authenticationToken;
    }
}
